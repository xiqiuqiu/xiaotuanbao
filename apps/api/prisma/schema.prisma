generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  enabled
  disabled

  @@map("user_status")
}

enum OrganizationStatus {
  enabled
  disabled

  @@map("organization_status")
}

enum DirectoryProfileStatus {
  active
  disabled
  archived

  @@map("directory_profile_status")
}

enum SettlementMethod {
  cash
  prepay
  postpay

  @@map("settlement_method")
}

enum SettlementCycle {
  per_group
  weekly
  semi_monthly
  monthly
  as_agreed

  @@map("settlement_cycle")
}

enum InvoiceAvailable {
  yes
  no

  @@map("invoice_available")
}

enum InvoiceType {
  normal
  special
  unsupported

  @@map("invoice_type")
}

enum PartnerKind {
  group_agent
  peer
  both

  @@map("partner_kind")
}

enum PartnerType {
  group_agency
  local_agency
  wholesaler
  integrated_agency
  other

  @@map("partner_type")
}

enum PartnerContactRole {
  owner
  operator
  finance
  sales
  customer_service
  other

  @@map("partner_contact_role")
}

enum DepartureRouteSource {
  template
  manual
  copy

  @@map("departure_route_source")
}

enum DepartureType {
  independent
  combined

  @@map("departure_type")
}

enum DepartureStatus {
  editing
  pending_settlement
  settled
  closed

  @@map("departure_status")
}

enum DepartureArchiveAction {
  archive
  unarchive

  @@map("departure_archive_action")
}

enum DepartureIncomeType {
  shopping_rebate
  coach_sales
  optional_tour
  other

  @@map("departure_income_type")
}

enum DepartureIncomeCollectionStatus {
  uncollected
  collected

  @@map("departure_income_collection_status")
}

enum DepartureIncomeCommissionStatus {
  unpaid
  paid

  @@map("departure_income_commission_status")
}

enum PaymentScheduleDirection {
  receivable
  payable

  @@map("payment_schedule_direction")
}

enum CounterpartyType {
  partner
  supplier
  guest

  @@map("counterparty_type")
}

enum TransactionDirection {
  inflow
  outflow

  @@map("transaction_direction")
}

enum PaymentChannel {
  cash
  bank_transfer
  wechat
  alipay
  other

  @@map("payment_channel")
}

enum VerificationStatus {
  normal
  cancelled

  @@map("verification_status")
}

enum PaymentScheduleCloseDisposition {
  external_or_special
  business_dispute_stop
  other

  @@map("payment_schedule_close_disposition")
}

enum PaymentScheduleActivityType {
  close
  void
  verification_cancelled
  reopen
  amount_adjust

  @@map("payment_schedule_activity_type")
}

enum ResourceKind {
  transport
  hotel
  guide
  ticket
  meal
  scenic
  shop
  entertainment
  insurance
  outsource
  other

  @@map("resource_kind")
}

enum SourceOrderDiscountType {
  none
  lump_sum

  @@map("source_order_discount_type")
}

enum SourceOrderCollectionMode {
  guest_only
  split
  partner_settled

  @@map("source_order_collection_mode")
}

enum FareAdjustmentDirection {
  increase
  decrease

  @@map("fare_adjustment_direction")
}

enum FareAdjustmentKind {
  child_ticket_topup
  single_room_topup
  extended_stay
  ticket_discount_refund
  lodging_deduction
  other

  @@map("fare_adjustment_kind")
}

enum GuestGender {
  male
  female
  unknown

  @@map("guest_gender")
}

enum DocumentSequenceType {
  departure
  ar
  ap
  tx
  cl

  @@map("document_sequence_type")
}

/// Product Type：第一期仅散拼。
enum ProductType {
  group_join

  @@map("product_type")
}

/// Product Status：草稿 / 销售中 / 已下架。
enum ProductStatus {
  draft
  on_sale
  offline

  @@map("product_status")
}

/// Product Schedule Status：销售中 / 已截止 / 已取消。
enum ProductScheduleStatus {
  on_sale
  closed
  cancelled

  @@map("product_schedule_status")
}

/// Product Import Session：外部总表迁入的服务端确认过程。
enum ProductImportSessionStatus {
  pending_confirmation
  confirmed
  discarded

  @@map("product_import_session_status")
}

model Organization {
  id             String             @id @default(cuid())
  name           String
  businessPrefix String             @unique @map("business_prefix")
  status         OrganizationStatus @default(enabled)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")
  users     User[]
  suppliers Supplier[]
  partners  Partner[]
  departures Departure[]
  departureArchiveHistories DepartureArchiveHistory[]
  departureSettlementHistories DepartureSettlementHistory[]
  routeTemplates RouteTemplate[]
  paymentSchedules PaymentSchedule[]
  paymentScheduleActivities PaymentScheduleActivity[]
  financeTransactions FinanceTransaction[]
  financeVerifications FinanceVerification[]
  financeIdempotencyRecords FinanceIdempotencyRecord[]
  documentSequences DocumentSequence[]
  storedObjects StoredObject[]
  products Product[]
  productImportSessions ProductImportSession[]
  bookingNoticeTemplates BookingNoticeTemplate[]
  aiCreateTasks AiCreateTask[]
  aiCreateIdempotencyRecords AiCreateIdempotencyRecord[]
  aiCreateActivityRuns AiCreateActivityRun[]
  aiReviewPackages AiReviewPackage[]
  aiReviewRecords AiReviewRecord[]

  @@map("organizations")
}

/// 组织级报名须知模板。产品引用时复制正文，之后改写不回写模板。
model BookingNoticeTemplate {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  content        String
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  products       Product[]

  @@unique([organizationId, name])
  @@index([organizationId, updatedAt])
  @@map("booking_notice_templates")
}

model FinanceIdempotencyRecord {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  operation      String
  idempotencyKey String       @map("idempotency_key")
  requestHash    String       @map("request_hash")
  resultJson     Json?        @map("result_json")
  completedAt    DateTime?    @map("completed_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([organizationId, operation, idempotencyKey])
  @@index([organizationId, createdAt])
  @@map("finance_idempotency_records")
}

model DocumentSequence {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  organization   Organization         @relation(fields: [organizationId], references: [id])
  documentType   DocumentSequenceType @map("document_type")
  periodKey      String               @map("period_key")
  lastSequence   Int                  @default(0) @map("last_sequence")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@unique([organizationId, documentType, periodKey])
  @@map("document_sequences")
}

model User {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  organization    Organization @relation(fields: [organizationId], references: [id])
  username        String
  passwordHash    String       @map("password_hash")
  name            String
  remark          String?
  status          UserStatus   @default(enabled)
  isPlatformAdmin Boolean      @default(false) @map("is_platform_admin")
  lastLoginAt     DateTime?    @map("last_login_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")
  roles           UserRole[]
  ownedDepartures Departure[]  @relation("DepartureOwner")
  departureArchiveOperations DepartureArchiveHistory[] @relation("DepartureArchiveOperator")
  departureSettlementOperations DepartureSettlementHistory[] @relation("DepartureSettlementOperator")
  paymentScheduleCancellations PaymentSchedule[] @relation("PaymentScheduleCancelOperator")
  paymentScheduleVoids PaymentSchedule[] @relation("PaymentScheduleVoidOperator")
  paymentScheduleActivities  PaymentScheduleActivity[] @relation("PaymentScheduleActivityOperator")
  createdStoredObjects StoredObject[] @relation("StoredObjectCreator")
  createdProductImportSessions ProductImportSession[] @relation("ProductImportSessionCreator")
  createdAiCreateTasks AiCreateTask[] @relation("AiCreateTaskCreator")
  aiCreateActivityRuns AiCreateActivityRun[] @relation("AiCreateActivityRunCreator")
  aiReviewRecords AiReviewRecord[] @relation("AiReviewRecordOperator")

  // Global uniqueness for non-deleted usernames is enforced by partial unique index
  // users_username_active_key (see migration); soft-deleted rows may reuse names.
  @@map("users")
}

/// Platform attachment metadata (ADR-0027). Bytes live in S3-compatible object storage.
model StoredObject {
  id               String       @id @default(cuid())
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id])
  objectKey        String       @unique @map("object_key")
  originalFilename String       @map("original_filename")
  contentType      String       @map("content_type")
  sizeBytes        Int          @map("size_bytes")
  createdByUserId  String       @map("created_by_user_id")
  createdByUser    User         @relation("StoredObjectCreator", fields: [createdByUserId], references: [id])
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  productImportSessions ProductImportSession[]

  @@index([organizationId, createdAt])
  @@map("stored_objects")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id        String           @id @default(cuid())
  key       String           @unique
  name      String
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  roles     RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Supplier {
  id                  String                 @id @default(cuid())
  organizationId      String                 @map("organization_id")
  organization        Organization           @relation(fields: [organizationId], references: [id])
  name                String
  categories          ResourceKind[]
  status              DirectoryProfileStatus @default(active)
  contactName         String?                @map("contact_name")
  contactPhone        String?                @map("contact_phone")
  settlementMethod    SettlementMethod?      @map("settlement_method")
  settlementCycle     SettlementCycle?       @map("settlement_cycle")
  settlementNotes     String?                @map("settlement_notes")
  referenceQuoteNotes String?                @map("reference_quote_notes")
  invoiceAvailable    InvoiceAvailable?      @map("invoice_available")
  invoiceType         InvoiceType?           @map("invoice_type")
  taxRate             String?                @map("tax_rate")
  accountName         String?                @map("account_name")
  bankName            String?                @map("bank_name")
  bankAccount         String?                @map("bank_account")
  businessNotes       String?                @map("business_notes")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  routeTemplateResources RouteTemplateResource[]
  segmentResources    SegmentResource[]
  departureResources  DepartureResource[]
  departuresAsDriver  Departure[]             @relation("DepartureDriverSupplier")
  departuresAsGuide   Departure[]             @relation("DepartureGuideSupplier")
  incomeRecordsAsPartner DepartureIncomeRecord[] @relation("DepartureIncomePartnerSupplier")
  incomeRecordsAsGuide   DepartureIncomeRecord[] @relation("DepartureIncomeGuideSupplier")

  @@unique([organizationId, name])
  @@map("suppliers")
}

model Partner {
  id               String                 @id @default(cuid())
  organizationId   String                 @map("organization_id")
  organization     Organization           @relation(fields: [organizationId], references: [id])
  name             String
  partnerKind      PartnerKind            @map("partner_kind")
  partnerType      PartnerType            @map("partner_type")
  status           DirectoryProfileStatus @default(active)
  contactName      String?                @map("contact_name")
  contactRole      PartnerContactRole?    @map("contact_role")
  contactPhone     String?                @map("contact_phone")
  settlementMethod SettlementMethod?      @map("settlement_method")
  paymentTermRule  SettlementCycle?       @map("payment_term_rule")
  settlementNotes  String?                @map("settlement_notes")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  routeTemplateResources RouteTemplateResource[]
  segmentResources    SegmentResource[]
  departureResources  DepartureResource[]
  sourceOrders        SourceOrder[]

  @@unique([organizationId, name])
  @@map("partners")
}

model RouteTemplate {
  id              String                 @id @default(cuid())
  organizationId  String                 @map("organization_id")
  organization    Organization           @relation(fields: [organizationId], references: [id])
  name            String
  defaultDayCount Int                    @map("default_day_count")
  usageCount      Int                    @default(0) @map("usage_count")
  notes           String?
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  segments        RouteTemplateSegment[]

  @@unique([organizationId, name])
  @@map("route_templates")
}

model RouteTemplateSegment {
  id          String                  @id @default(cuid())
  templateId  String                  @map("template_id")
  template    RouteTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sortOrder   Int                     @map("sort_order")
  name        String
  dayCount    Int?                    @map("day_count")
  destination String?
  notes       String?
  resources   RouteTemplateResource[]

  @@map("route_template_segments")
}

model RouteTemplateResource {
  id                String               @id @default(cuid())
  templateSegmentId String               @map("template_segment_id")
  templateSegment   RouteTemplateSegment @relation(fields: [templateSegmentId], references: [id], onDelete: Cascade)
  resourceKind      ResourceKind         @map("resource_kind")
  counterpartyType  CounterpartyType     @map("counterparty_type")
  partnerId         String?              @map("partner_id")
  partner           Partner?             @relation(fields: [partnerId], references: [id])
  supplierId        String?              @map("supplier_id")
  supplier          Supplier?            @relation(fields: [supplierId], references: [id])
  title             String
  amountCents       Int                  @map("amount_cents")
  notes             String?

  @@map("route_template_resources")
}

model Departure {
  id               String               @id @default(cuid())
  organizationId   String               @map("organization_id")
  organization     Organization         @relation(fields: [organizationId], references: [id])
  departureNo      String               @map("departure_no")
  name             String
  routeName        String               @map("route_name")
  routeSource      DepartureRouteSource @default(manual) @map("route_source")
  sourceTemplateId String?              @map("source_template_id")
  departureType    DepartureType        @default(combined) @map("departure_type")
  startDate        DateTime             @map("start_date") @db.Date
  endDate          DateTime             @map("end_date") @db.Date
  dayCount         Int                  @map("day_count")
  ownerUserId      String               @map("owner_user_id")
  owner            User                 @relation("DepartureOwner", fields: [ownerUserId], references: [id])
  driverSupplierId String?              @map("driver_supplier_id")
  driverSupplier   Supplier?            @relation("DepartureDriverSupplier", fields: [driverSupplierId], references: [id], onDelete: SetNull)
  guideSupplierId  String?              @map("guide_supplier_id")
  guideSupplier    Supplier?            @relation("DepartureGuideSupplier", fields: [guideSupplierId], references: [id], onDelete: SetNull)
  vehiclePlate     String?              @map("vehicle_plate")
  contactPhone     String?              @map("contact_phone")
  status           DepartureStatus      @default(editing)
  notes            String?
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  paymentSchedules PaymentSchedule[]
  financeTransactions FinanceTransaction[]
  itinerarySegments   ItinerarySegment[]
  departureResources  DepartureResource[]
  sourceOrders        SourceOrder[]
  incomeRecords       DepartureIncomeRecord[]
  archiveHistories    DepartureArchiveHistory[]
  settlementHistories DepartureSettlementHistory[]
  aiCreateTask        AiCreateTask?

  @@unique([organizationId, departureNo])
  @@map("departures")
}

/// 团内增收记录（取代 Ground Income Ledger；ADR-0036）
model DepartureIncomeRecord {
  id                 String                          @id @default(cuid())
  departureId        String                          @map("departure_id")
  departure          Departure                       @relation(fields: [departureId], references: [id], onDelete: Cascade)
  type               DepartureIncomeType
  projectName        String                          @map("project_name") @db.VarChar(50)
  partnerSupplierId   String?                         @map("partner_supplier_id")
  partnerSupplier     Supplier?                       @relation("DepartureIncomePartnerSupplier", fields: [partnerSupplierId], references: [id], onDelete: SetNull)
  occurredOn         DateTime                        @map("occurred_on") @db.Date
  amountCents        Int                             @map("amount_cents")
  guideSupplierId    String?                         @map("guide_supplier_id")
  guideSupplier      Supplier?                       @relation("DepartureIncomeGuideSupplier", fields: [guideSupplierId], references: [id], onDelete: SetNull)
  commissionCents    Int                             @default(0) @map("commission_cents")
  incomeStatus       DepartureIncomeCollectionStatus @default(uncollected) @map("income_status")
  commissionStatus   DepartureIncomeCommissionStatus @default(unpaid) @map("commission_status")
  remark             String?                         @db.VarChar(200)
  createdAt          DateTime                        @default(now()) @map("created_at")
  updatedAt          DateTime                        @updatedAt @map("updated_at")

  @@index([departureId, createdAt])
  @@map("departure_income_records")
}

model DepartureArchiveHistory {
  id             String                 @id @default(cuid())
  organizationId String                 @map("organization_id")
  organization   Organization           @relation(fields: [organizationId], references: [id])
  departureId    String                 @map("departure_id")
  departure      Departure              @relation(fields: [departureId], references: [id], onDelete: Cascade)
  action         DepartureArchiveAction
  reason         String
  operatedBy     String                 @map("operated_by")
  operator       User                   @relation("DepartureArchiveOperator", fields: [operatedBy], references: [id])
  operatedAt     DateTime               @default(now()) @map("operated_at")

  @@index([departureId, operatedAt])
  @@index([organizationId, departureId])
  @@map("departure_archive_histories")
}

model DepartureSettlementHistory {
  id                       String          @id @default(cuid())
  organizationId           String          @map("organization_id")
  organization             Organization    @relation(fields: [organizationId], references: [id])
  departureId              String          @map("departure_id")
  departure                Departure       @relation(fields: [departureId], references: [id], onDelete: Cascade)
  triggerPaymentScheduleId String          @map("trigger_payment_schedule_id")
  triggerPaymentSchedule   PaymentSchedule @relation(fields: [triggerPaymentScheduleId], references: [id])
  reason                   String
  previousStatus           DepartureStatus @map("previous_status")
  newStatus                DepartureStatus @map("new_status")
  operatedBy               String          @map("operated_by")
  operator                 User            @relation("DepartureSettlementOperator", fields: [operatedBy], references: [id])
  operatedAt               DateTime        @default(now()) @map("operated_at")

  @@index([departureId, operatedAt])
  @@index([organizationId, departureId])
  @@map("departure_settlement_histories")
}

model SourceOrder {
  id                       String                      @id @default(cuid())
  departureId              String                      @map("departure_id")
  departure                Departure                   @relation(fields: [departureId], references: [id], onDelete: Cascade)
  partnerId                String                      @map("partner_id")
  partner                  Partner                     @relation(fields: [partnerId], references: [id])
  displayName              String                      @map("display_name")
  guestCount               Int                         @map("guest_count")
  adultGuestCount          Int                         @map("adult_guest_count")
  childGuestCount          Int                         @map("child_guest_count")
  adultUnitPriceCents      Int                         @map("adult_unit_price_cents")
  childUnitPriceCents      Int                         @map("child_unit_price_cents")
  grossReceivableCents     Int                         @map("gross_receivable_cents")
  fareAdjustmentNetCents   Int                         @default(0) @map("fare_adjustment_net_cents")
  discountType             SourceOrderDiscountType     @default(none) @map("discount_type")
  discountCents            Int                         @default(0) @map("discount_cents")
  discountNotes            String?                     @map("discount_notes")
  netReceivableCents       Int                         @map("net_receivable_cents")
  collectionMode           SourceOrderCollectionMode   @map("collection_mode")
  /** 定金（分）；代收场景录入；全部客户结算为 0。 */
  depositCents             Int                         @default(0) @map("deposit_cents")
  /** 尾款（分）；代收场景录入；全部客户结算为 0。 */
  balanceCents             Int                         @default(0) @map("balance_cents")
  /** 客户已收 P（由收款方式与定金/尾款派生）。 */
  partnerCollectedCents    Int                         @map("partner_collected_cents")
  /** 我方代收 G约定（由收款方式与定金/尾款派生）。 */
  guestCollectCents        Int                         @map("guest_collect_cents")
  settlementNotes          String?                     @map("settlement_notes")
  notes                    String?
  createdAt                DateTime                    @default(now()) @map("created_at")
  updatedAt                DateTime                    @updatedAt @map("updated_at")
  guests                   SourceOrderGuest[]
  fareAdjustments          SourceOrderFareAdjustment[]

  @@index([departureId, partnerId])
  @@map("source_orders")
}

model SourceOrderFareAdjustment {
  id            String                  @id @default(cuid())
  sourceOrderId String                  @map("source_order_id")
  sourceOrder   SourceOrder             @relation(fields: [sourceOrderId], references: [id], onDelete: Cascade)
  kind          FareAdjustmentKind
  direction     FareAdjustmentDirection
  amountCents   Int                     @map("amount_cents")
  customName    String?                 @map("custom_name")
  sortOrder     Int                     @default(0) @map("sort_order")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  @@index([sourceOrderId])
  @@map("source_order_fare_adjustments")
}

model SourceOrderGuest {
  id            String      @id @default(cuid())
  sourceOrderId String      @map("source_order_id")
  sourceOrder   SourceOrder @relation(fields: [sourceOrderId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  gender        GuestGender @default(unknown)
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("source_order_guests")
}

model ItinerarySegment {
  id                   String            @id @default(cuid())
  departureId          String            @map("departure_id")
  departure            Departure         @relation(fields: [departureId], references: [id], onDelete: Cascade)
  name                 String
  sortOrder            Int               @map("sort_order")
  startDate            DateTime?         @map("start_date") @db.Date
  endDate              DateTime?         @map("end_date") @db.Date
  dayCount             Int?              @map("day_count")
  destination  String?
  notes        String?
  /// Ticket type headcount: 全/半/学/免（非负整数）。
  fullTicketCount      Int               @default(0) @map("full_ticket_count")
  halfTicketCount      Int               @default(0) @map("half_ticket_count")
  studentTicketCount   Int               @default(0) @map("student_ticket_count")
  freeTicketCount      Int               @default(0) @map("free_ticket_count")
  /// Copy/template skeleton awaiting coordinator review; cleared on segment drawer save.
  pendingCheck Boolean @default(false) @map("pending_check")
  resources            SegmentResource[]

  @@map("itinerary_segments")
}

model SegmentResource {
  id               String           @id @default(cuid())
  segmentId        String           @map("segment_id")
  segment          ItinerarySegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  resourceKind     ResourceKind     @map("resource_kind")
  counterpartyType CounterpartyType @map("counterparty_type")
  partnerId        String?          @map("partner_id")
  partner          Partner?         @relation(fields: [partnerId], references: [id])
  supplierId       String?          @map("supplier_id")
  supplier         Supplier?        @relation(fields: [supplierId], references: [id])
  title            String
  amountCents      Int              @map("amount_cents")
  notes            String?
  /// Copy/template skeleton awaiting coordinator review; cleared on resource drawer save.
  pendingCheck     Boolean          @default(false) @map("pending_check")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@map("segment_resources")
}

/// 发团级成本费用行（全程用车/保险/导游等）；规则与 SegmentResource 同一套。
model DepartureResource {
  id               String           @id @default(cuid())
  departureId      String           @map("departure_id")
  departure        Departure        @relation(fields: [departureId], references: [id], onDelete: Cascade)
  resourceKind     ResourceKind     @map("resource_kind")
  counterpartyType CounterpartyType @map("counterparty_type")
  partnerId        String?          @map("partner_id")
  partner          Partner?         @relation(fields: [partnerId], references: [id])
  supplierId       String?          @map("supplier_id")
  supplier         Supplier?        @relation(fields: [supplierId], references: [id])
  title            String
  amountCents      Int              @map("amount_cents")
  notes            String?
  pendingCheck     Boolean          @default(false) @map("pending_check")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@map("departure_resources")
}

model PaymentSchedule {
  id               String                   @id @default(cuid())
  organizationId   String                   @map("organization_id")
  organization     Organization             @relation(fields: [organizationId], references: [id])
  departureId      String                   @map("departure_id")
  departure        Departure                @relation(fields: [departureId], references: [id])
  direction        PaymentScheduleDirection
  scheduleNo       String                   @map("schedule_no")
  title            String
  amountCents      Int                      @map("amount_cents")
  dueDate          DateTime                 @map("due_date") @db.Date
  counterpartyType CounterpartyType         @map("counterparty_type")
  counterpartyId   String?                  @map("counterparty_id")
  counterpartyName String?                  @map("counterparty_name")
  sourceType       String                   @default("manual") @map("source_type")
  sourceId         String?                  @map("source_id")
  cancelledAt      DateTime?                @map("cancelled_at")
  cancelledBy      String?                  @map("cancelled_by")
  cancelOperator   User?                    @relation("PaymentScheduleCancelOperator", fields: [cancelledBy], references: [id])
  closeDisposition PaymentScheduleCloseDisposition? @map("close_disposition")
  cancelReason     String?                  @map("cancel_reason")
  voidedAt         DateTime?                @map("voided_at")
  voidedBy         String?                  @map("voided_by")
  voidOperator     User?                    @relation("PaymentScheduleVoidOperator", fields: [voidedBy], references: [id])
  voidReason       String?                  @map("void_reason")
  voidedAmountCents Int?                    @map("voided_amount_cents")
  amountAdjustedAt DateTime?                @map("amount_adjusted_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  verifications FinanceVerification[]
  activities    PaymentScheduleActivity[]
  settlementHistories DepartureSettlementHistory[]

  @@unique([organizationId, scheduleNo])
  @@index([organizationId, departureId])
  @@map("payment_schedules")
}

model PaymentScheduleActivity {
  id                           String                            @id @default(cuid())
  organizationId               String                            @map("organization_id")
  organization                 Organization                      @relation(fields: [organizationId], references: [id])
  paymentScheduleId            String                            @map("payment_schedule_id")
  paymentSchedule              PaymentSchedule                   @relation(fields: [paymentScheduleId], references: [id], onDelete: Cascade)
  activityType                 PaymentScheduleActivityType       @map("activity_type")
  closeDisposition             PaymentScheduleCloseDisposition?  @map("close_disposition")
  note                         String
  amountCents                  Int?                              @map("amount_cents")
  previousAmountCents          Int?                              @map("previous_amount_cents")
  settledAmountCents           Int?                              @map("settled_amount_cents")
  unsettledAmountCents         Int?                              @map("unsettled_amount_cents")
  previousSettledAmountCents   Int?                              @map("previous_settled_amount_cents")
  previousUnsettledAmountCents Int?                              @map("previous_unsettled_amount_cents")
  verificationId               String?                           @map("verification_id")
  operatedBy                   String                            @map("operated_by")
  operator                     User                              @relation("PaymentScheduleActivityOperator", fields: [operatedBy], references: [id])
  operatedAt                   DateTime                          @default(now()) @map("operated_at")

  @@index([paymentScheduleId, operatedAt])
  @@index([organizationId, paymentScheduleId])
  @@map("payment_schedule_activities")
}

model FinanceTransaction {
  id               String               @id @default(cuid())
  organizationId   String               @map("organization_id")
  organization     Organization         @relation(fields: [organizationId], references: [id])
  transactionNo    String               @map("transaction_no")
  direction        TransactionDirection
  paymentChannel   PaymentChannel       @default(other) @map("payment_channel")
  amountCents      Int                  @map("amount_cents")
  transactionDate  DateTime             @map("transaction_date") @db.Date
  counterpartyType CounterpartyType     @map("counterparty_type")
  counterpartyId   String?              @map("counterparty_id")
  counterpartyName String?              @map("counterparty_name")
  departureId      String?              @map("departure_id")
  departure        Departure?           @relation(fields: [departureId], references: [id])
  voidedAt               DateTime?            @map("voided_at")
  voidReason             String?              @map("void_reason")
  notes                  String?
  sourceAmountChangedAt  DateTime?            @map("source_amount_changed_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  verifications          FinanceVerification[]

  @@unique([organizationId, transactionNo])
  @@index([organizationId, departureId])
  @@map("finance_transactions")
}

model FinanceVerification {
  id                      String             @id @default(cuid())
  organizationId          String             @map("organization_id")
  organization            Organization       @relation(fields: [organizationId], references: [id])
  verificationNo          String             @map("verification_no")
  paymentScheduleId       String             @map("payment_schedule_id")
  paymentSchedule         PaymentSchedule    @relation(fields: [paymentScheduleId], references: [id])
  transactionId           String             @map("transaction_id")
  transaction             FinanceTransaction @relation(fields: [transactionId], references: [id])
  amountCents             Int                @map("amount_cents")
  verificationDate        DateTime           @map("verification_date") @db.Date
  remark                  String?
  createdBy               String             @map("created_by")
  cancelledBy             String?            @map("cancelled_by")
  cancelReason            String?            @map("cancel_reason")
  billUnsettledAfterCents Int                @map("bill_unsettled_after_cents")
  status                  VerificationStatus @default(normal)
  cancelledAt             DateTime?          @map("cancelled_at")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  @@unique([organizationId, verificationNo])
  @@index([paymentScheduleId, status])
  @@index([transactionId, status])
  @@map("finance_verifications")
}

/// 散拼产品（Product Center）。营销行程与对外报价聚合根；≠ 发团、≠ 常用路线。
model Product {
  id                String         @id @default(cuid())
  organizationId    String         @map("organization_id")
  organization      Organization   @relation(fields: [organizationId], references: [id])
  name              String
  productType       ProductType    @default(group_join) @map("product_type")
  status            ProductStatus  @default(draft)
  shortItinerary    String         @default("") @map("short_itinerary")
  detailedItinerary String?        @map("detailed_itinerary")
  /// 特色条目的派生拼接（导入兼容 / 导出便利）；真相源为 ProductFeature。
  featuresText      String?        @map("features_text")
  bookingNotice     String?        @map("booking_notice")
  /// 最近一次引用的组织须知模板；仅作溯源，不活引用正文。
  bookingNoticeTemplateId String?                 @map("booking_notice_template_id")
  bookingNoticeTemplate   BookingNoticeTemplate?  @relation(fields: [bookingNoticeTemplateId], references: [id], onDelete: SetNull)
  startCity         String?        @map("start_city")
  endCity           String?        @map("end_city")
  dayCount          Int?           @map("day_count")
  tags              String[]       @default([])
  /// Product Import Session；手建产品为空。
  importSessionId   String?        @map("import_session_id")
  importSession     ProductImportSession? @relation(fields: [importSessionId], references: [id], onDelete: SetNull)
  /// 来源 Sheet 名，供列表筛选。
  sourceSheetName   String?        @map("source_sheet_name")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  specs             ProductSpec[]
  schedules         ProductSchedule[]
  features          ProductFeature[]

  @@index([organizationId, status, updatedAt])
  @@index([organizationId, name])
  @@index([organizationId, importSessionId])
  @@index([organizationId, sourceSheetName])
  @@index([bookingNoticeTemplateId])
  @@map("products")
}

/// Product Feature：营销卖点条目；可空集合；不承载报名规则。
model ProductFeature {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title       String   @default("")
  description String   @default("")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([productId, sortOrder])
  @@map("product_features")
}

/// Product Import Session：归档原件 + 解析候选项 + 确认落草稿。
model ProductImportSession {
  id               String                     @id @default(cuid())
  organizationId   String                     @map("organization_id")
  organization     Organization               @relation(fields: [organizationId], references: [id])
  storedObjectId   String                     @map("stored_object_id")
  storedObject     StoredObject               @relation(fields: [storedObjectId], references: [id], onDelete: Restrict)
  status           ProductImportSessionStatus @default(pending_confirmation)
  originalFilename String                     @map("original_filename")
  /// JiangyoujiParseResult JSON（服务端真相）。
  parseResultJson  Json                       @map("parse_result_json")
  embeddedOleCount Int                        @default(0) @map("embedded_ole_count")
  createdByUserId  String                     @map("created_by_user_id")
  createdByUser    User                       @relation("ProductImportSessionCreator", fields: [createdByUserId], references: [id])
  confirmedAt      DateTime?                  @map("confirmed_at")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")
  products         Product[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@map("product_import_sessions")
}

/// Product Spec：规格默认销售价；供新建班期复制，不回写既有班期（ADR-0025）。
model ProductSpec {
  id                         String            @id @default(cuid())
  productId                  String            @map("product_id")
  product                    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  name                       String            @default("标准")
  adultPriceCents            Int?              @map("adult_price_cents")
  childPriceCents            Int?              @map("child_price_cents")
  singleRoomSupplementCents  Int?              @map("single_room_supplement_cents")
  notes                      String?
  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")
  schedules                  ProductSchedule[]

  @@unique([productId, name])
  @@map("product_specs")
}

/// Product Schedule：班期 + 创建时价格快照（ADR-0025）。
model ProductSchedule {
  id                        String                @id @default(cuid())
  productId                 String                @map("product_id")
  product                   Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  productSpecId             String                @map("product_spec_id")
  productSpec               ProductSpec           @relation(fields: [productSpecId], references: [id], onDelete: Restrict)
  title                     String                @default("")
  /// 班期日期规则原文（如「天天发团」「每周一、五」）。
  dateRuleText              String                @default("") @map("date_rule_text")
  startDate                 DateTime?             @map("start_date") @db.Date
  endDate                   DateTime?             @map("end_date") @db.Date
  status                    ProductScheduleStatus @default(on_sale)
  /// 明确询价：可无成人价仍作为可展示班期参与上架门槛。
  priceOnInquiry            Boolean               @default(false) @map("price_on_inquiry")
  adultPriceCents           Int?                  @map("adult_price_cents")
  childPriceCents           Int?                  @map("child_price_cents")
  singleRoomSupplementCents Int?                  @map("single_room_supplement_cents")
  notes                     String?
  createdAt                 DateTime              @default(now()) @map("created_at")
  updatedAt                 DateTime              @updatedAt @map("updated_at")

  @@index([productId, status])
  @@map("product_schedules")
}

enum AiCreateTaskStatus {
  in_progress
  completed
  abandoned

  @@map("ai_create_task_status")
}

enum AiCreatePhase {
  basic_info

  @@map("ai_create_phase")
}

enum AiCreateActivityRunStatus {
  running
  completed
  failed

  @@map("ai_create_activity_run_status")
}

/// AI 建团任务：表单/AI 共用的可恢复任务壳；正式 Departure 创建前关联发团创建草稿。
model AiCreateTask {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  organization   Organization      @relation(fields: [organizationId], references: [id])
  creatorUserId  String            @map("creator_user_id")
  creator        User              @relation("AiCreateTaskCreator", fields: [creatorUserId], references: [id])
  status         AiCreateTaskStatus @default(in_progress)
  currentPhase   AiCreatePhase     @default(basic_info) @map("current_phase")
  departureId    String?           @unique @map("departure_id")
  departure      Departure?        @relation(fields: [departureId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  draft          DepartureCreationDraft?
  idempotencyRecords AiCreateIdempotencyRecord[]
  activityRuns   AiCreateActivityRun[]
  reviewPackages AiReviewPackage[]

  @@index([organizationId, creatorUserId, status, updatedAt])
  @@map("ai_create_tasks")
}

/// 发团创建草稿：正式 Departure 创建前的结构化建团资料；不预占正式团号。
model DepartureCreationDraft {
  id        String       @id @default(cuid())
  taskId    String       @unique @map("task_id")
  task      AiCreateTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  version   Int          @default(1)
  snapshot  Json
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("departure_creation_drafts")
}

model AiCreateIdempotencyRecord {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskId         String       @map("task_id")
  task           AiCreateTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  operation      String
  idempotencyKey String       @map("idempotency_key")
  requestHash    String       @map("request_hash")
  resultJson     Json?        @map("result_json")
  completedAt    DateTime?    @map("completed_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([organizationId, operation, idempotencyKey])
  @@index([taskId])
  @@index([organizationId, createdAt])
  @@map("ai_create_idempotency_records")
}

/// AI 建团活动运行：同一任务同一时间至多一个 running。
model AiCreateActivityRun {
  id             String                     @id @default(cuid())
  organizationId String                     @map("organization_id")
  organization   Organization               @relation(fields: [organizationId], references: [id])
  taskId         String                     @map("task_id")
  task           AiCreateTask               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  creatorUserId  String                     @map("creator_user_id")
  creator        User                       @relation("AiCreateActivityRunCreator", fields: [creatorUserId], references: [id])
  status         AiCreateActivityRunStatus  @default(running)
  startedAt      DateTime                   @default(now()) @map("started_at")
  endedAt        DateTime?                  @map("ended_at")
  errorCode      String?                    @map("error_code")
  reviewPackages AiReviewPackage[]

  @@index([taskId, status])
  @@index([organizationId, startedAt])
  @@map("ai_create_activity_runs")
}

enum AiReviewPackageStatus {
  pending
  confirmed
  rejected
  superseded

  @@map("ai_review_package_status")
}

enum AiReviewRecordAction {
  confirm
  reject

  @@map("ai_review_record_action")
}

enum AiReviewWriteResult {
  success
  conflict
  permission_denied
  validation_failed
  rejected

  @@map("ai_review_write_result")
}

/// AI 阶段审核包：待确认候选，确认前不写入发团创建草稿。
model AiReviewPackage {
  id                 String                @id @default(cuid())
  organizationId     String                @map("organization_id")
  organization       Organization          @relation(fields: [organizationId], references: [id])
  taskId             String                @map("task_id")
  task               AiCreateTask          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  runId              String                @map("run_id")
  run                AiCreateActivityRun   @relation(fields: [runId], references: [id])
  status             AiReviewPackageStatus @default(pending)
  confirmationUnit   String                @default("basic_info_draft") @map("confirmation_unit")
  baseObjectVersion  Int                   @map("base_object_version")
  baselineSnapshot   Json                  @map("baseline_snapshot")
  candidates         Json
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  records            AiReviewRecord[]

  @@index([taskId, status])
  @@index([organizationId, createdAt])
  @@map("ai_review_packages")
}

/// AI 审核记录：只读处置历史，成功与失败均保留。
model AiReviewRecord {
  id                 String              @id @default(cuid())
  organizationId     String              @map("organization_id")
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  packageId          String              @map("package_id")
  package            AiReviewPackage     @relation(fields: [packageId], references: [id], onDelete: Cascade)
  operatorUserId     String              @map("operator_user_id")
  operator           User                @relation("AiReviewRecordOperator", fields: [operatorUserId], references: [id])
  action             AiReviewRecordAction
  originalCandidates Json                @map("original_candidates")
  userCorrections    Json                @map("user_corrections")
  submittedValues    Json                @map("submitted_values")
  evidence           Json
  objectVersion      Int                 @map("object_version")
  writeResult        AiReviewWriteResult @map("write_result")
  conflictFields     Json?               @map("conflict_fields")
  createdAt          DateTime            @default(now()) @map("created_at")

  @@index([packageId, createdAt])
  @@index([organizationId, createdAt])
  @@map("ai_review_records")
}

