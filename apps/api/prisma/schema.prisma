generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  enabled
  disabled

  @@map("user_status")
}

enum DirectoryProfileStatus {
  active
  disabled
  archived

  @@map("directory_profile_status")
}

enum SupplierCategory {
  restaurant
  hotel
  transport
  guide
  scenic
  shop
  entertainment
  insurance
  ticket
  other

  @@map("supplier_category")
}

enum SettlementMethod {
  cash
  prepay
  postpay

  @@map("settlement_method")
}

enum SettlementCycle {
  per_group
  weekly
  semi_monthly
  monthly
  as_agreed

  @@map("settlement_cycle")
}

enum InvoiceAvailable {
  yes
  no

  @@map("invoice_available")
}

enum InvoiceType {
  normal
  special
  unsupported

  @@map("invoice_type")
}

enum PartnerKind {
  group_agent
  peer
  both

  @@map("partner_kind")
}

enum PartnerType {
  group_agency
  local_agency
  wholesaler
  integrated_agency
  other

  @@map("partner_type")
}

enum PartnerContactRole {
  owner
  operator
  finance
  sales
  customer_service
  other

  @@map("partner_contact_role")
}

enum DepartureRouteSource {
  template
  manual
  copy

  @@map("departure_route_source")
}

enum DepartureType {
  independent
  combined

  @@map("departure_type")
}

enum DepartureStatus {
  editing
  pending_settlement
  settled
  closed

  @@map("departure_status")
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  users     User[]
  suppliers Supplier[]
  partners  Partner[]
  departures Departure[]

  @@map("organizations")
}

model User {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  organization    Organization @relation(fields: [organizationId], references: [id])
  username        String
  passwordHash    String       @map("password_hash")
  name            String
  remark          String?
  status          UserStatus   @default(enabled)
  isPlatformAdmin Boolean      @default(false) @map("is_platform_admin")
  lastLoginAt     DateTime?    @map("last_login_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")
  roles           UserRole[]
  ownedDepartures Departure[]  @relation("DepartureOwner")

  @@unique([organizationId, username])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id        String           @id @default(cuid())
  key       String           @unique
  name      String
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  roles     RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Supplier {
  id                  String                 @id @default(cuid())
  organizationId      String                 @map("organization_id")
  organization        Organization           @relation(fields: [organizationId], references: [id])
  name                String
  category            SupplierCategory
  status              DirectoryProfileStatus @default(active)
  contactName         String?                @map("contact_name")
  contactPhone        String?                @map("contact_phone")
  settlementMethod    SettlementMethod?      @map("settlement_method")
  settlementCycle     SettlementCycle?       @map("settlement_cycle")
  settlementNotes     String?                @map("settlement_notes")
  referenceQuoteNotes String?                @map("reference_quote_notes")
  invoiceAvailable    InvoiceAvailable?      @map("invoice_available")
  invoiceType         InvoiceType?           @map("invoice_type")
  taxRate             String?                @map("tax_rate")
  accountName         String?                @map("account_name")
  bankName            String?                @map("bank_name")
  bankAccount         String?                @map("bank_account")
  businessNotes       String?                @map("business_notes")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  @@unique([organizationId, name])
  @@map("suppliers")
}

model Partner {
  id               String                 @id @default(cuid())
  organizationId   String                 @map("organization_id")
  organization     Organization           @relation(fields: [organizationId], references: [id])
  name             String
  partnerKind      PartnerKind            @map("partner_kind")
  partnerType      PartnerType            @map("partner_type")
  status           DirectoryProfileStatus @default(active)
  contactName      String?                @map("contact_name")
  contactRole      PartnerContactRole?    @map("contact_role")
  contactPhone     String?                @map("contact_phone")
  settlementMethod SettlementMethod?      @map("settlement_method")
  paymentTermRule  SettlementCycle?       @map("payment_term_rule")
  settlementNotes  String?                @map("settlement_notes")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  @@unique([organizationId, name])
  @@map("partners")
}

model Departure {
  id               String               @id @default(cuid())
  organizationId   String               @map("organization_id")
  organization     Organization         @relation(fields: [organizationId], references: [id])
  departureNo      String               @map("departure_no")
  name             String
  routeName        String               @map("route_name")
  routeSource      DepartureRouteSource @default(manual) @map("route_source")
  sourceTemplateId String?              @map("source_template_id")
  departureType    DepartureType        @default(combined) @map("departure_type")
  startDate        DateTime             @map("start_date") @db.Date
  endDate          DateTime             @map("end_date") @db.Date
  dayCount         Int                  @map("day_count")
  ownerUserId      String               @map("owner_user_id")
  owner            User                 @relation("DepartureOwner", fields: [ownerUserId], references: [id])
  status           DepartureStatus      @default(editing)
  notes            String?
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@unique([organizationId, departureNo])
  @@map("departures")
}
