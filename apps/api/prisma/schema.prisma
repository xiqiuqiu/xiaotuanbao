generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  enabled
  disabled

  @@map("user_status")
}

enum DirectoryProfileStatus {
  active
  disabled
  archived

  @@map("directory_profile_status")
}

enum SettlementMethod {
  cash
  prepay
  postpay

  @@map("settlement_method")
}

enum SettlementCycle {
  per_group
  weekly
  semi_monthly
  monthly
  as_agreed

  @@map("settlement_cycle")
}

enum InvoiceAvailable {
  yes
  no

  @@map("invoice_available")
}

enum InvoiceType {
  normal
  special
  unsupported

  @@map("invoice_type")
}

enum PartnerKind {
  group_agent
  peer
  both

  @@map("partner_kind")
}

enum PartnerType {
  group_agency
  local_agency
  wholesaler
  integrated_agency
  other

  @@map("partner_type")
}

enum PartnerContactRole {
  owner
  operator
  finance
  sales
  customer_service
  other

  @@map("partner_contact_role")
}

enum DepartureRouteSource {
  template
  manual
  copy

  @@map("departure_route_source")
}

enum DepartureType {
  independent
  combined

  @@map("departure_type")
}

enum DepartureStatus {
  editing
  pending_settlement
  settled
  closed

  @@map("departure_status")
}

enum DepartureArchiveAction {
  archive
  unarchive

  @@map("departure_archive_action")
}

enum PaymentScheduleDirection {
  receivable
  payable

  @@map("payment_schedule_direction")
}

enum CounterpartyType {
  partner
  supplier
  guest
  manual

  @@map("counterparty_type")
}

enum TransactionDirection {
  inflow
  outflow

  @@map("transaction_direction")
}

enum PaymentChannel {
  cash
  bank_transfer
  wechat
  alipay
  other

  @@map("payment_channel")
}

enum VerificationStatus {
  normal
  cancelled

  @@map("verification_status")
}

enum PaymentScheduleCloseDisposition {
  external_or_special
  business_dispute_stop
  other

  @@map("payment_schedule_close_disposition")
}

enum PaymentScheduleActivityType {
  close
  verification_cancelled
  reopen

  @@map("payment_schedule_activity_type")
}

enum ResourceKind {
  transport
  hotel
  guide
  ticket
  meal
  scenic
  shop
  entertainment
  insurance
  outsource
  other

  @@map("resource_kind")
}

enum SourceOrderDiscountType {
  none
  lump_sum

  @@map("source_order_discount_type")
}

enum SourceOrderCollectionMode {
  guest_only
  split
  partner_settled

  @@map("source_order_collection_mode")
}

enum GuestGender {
  male
  female
  unknown

  @@map("guest_gender")
}

enum DocumentSequenceType {
  departure
  ar
  ap
  tx
  cl

  @@map("document_sequence_type")
}

model Organization {
  id             String    @id @default(cuid())
  name           String
  businessPrefix String    @unique @map("business_prefix")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  users     User[]
  suppliers Supplier[]
  partners  Partner[]
  departures Departure[]
  departureArchiveHistories DepartureArchiveHistory[]
  departureSettlementHistories DepartureSettlementHistory[]
  routeTemplates RouteTemplate[]
  paymentSchedules PaymentSchedule[]
  paymentScheduleActivities PaymentScheduleActivity[]
  financeTransactions FinanceTransaction[]
  financeVerifications FinanceVerification[]
  documentSequences DocumentSequence[]

  @@map("organizations")
}

model DocumentSequence {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  organization   Organization         @relation(fields: [organizationId], references: [id])
  documentType   DocumentSequenceType @map("document_type")
  periodKey      String               @map("period_key")
  lastSequence   Int                  @default(0) @map("last_sequence")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@unique([organizationId, documentType, periodKey])
  @@map("document_sequences")
}

model User {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  organization    Organization @relation(fields: [organizationId], references: [id])
  username        String
  passwordHash    String       @map("password_hash")
  name            String
  remark          String?
  status          UserStatus   @default(enabled)
  isPlatformAdmin Boolean      @default(false) @map("is_platform_admin")
  lastLoginAt     DateTime?    @map("last_login_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")
  roles           UserRole[]
  ownedDepartures Departure[]  @relation("DepartureOwner")
  departureArchiveOperations DepartureArchiveHistory[] @relation("DepartureArchiveOperator")
  departureSettlementOperations DepartureSettlementHistory[] @relation("DepartureSettlementOperator")
  paymentScheduleCancellations PaymentSchedule[] @relation("PaymentScheduleCancelOperator")
  paymentScheduleActivities  PaymentScheduleActivity[] @relation("PaymentScheduleActivityOperator")

  @@unique([organizationId, username])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id        String           @id @default(cuid())
  key       String           @unique
  name      String
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  roles     RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Supplier {
  id                  String                 @id @default(cuid())
  organizationId      String                 @map("organization_id")
  organization        Organization           @relation(fields: [organizationId], references: [id])
  name                String
  categories          ResourceKind[]
  status              DirectoryProfileStatus @default(active)
  contactName         String?                @map("contact_name")
  contactPhone        String?                @map("contact_phone")
  settlementMethod    SettlementMethod?      @map("settlement_method")
  settlementCycle     SettlementCycle?       @map("settlement_cycle")
  settlementNotes     String?                @map("settlement_notes")
  referenceQuoteNotes String?                @map("reference_quote_notes")
  invoiceAvailable    InvoiceAvailable?      @map("invoice_available")
  invoiceType         InvoiceType?           @map("invoice_type")
  taxRate             String?                @map("tax_rate")
  accountName         String?                @map("account_name")
  bankName            String?                @map("bank_name")
  bankAccount         String?                @map("bank_account")
  businessNotes       String?                @map("business_notes")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  routeTemplateResources RouteTemplateResource[]
  segmentResources    SegmentResource[]

  @@unique([organizationId, name])
  @@map("suppliers")
}

model Partner {
  id               String                 @id @default(cuid())
  organizationId   String                 @map("organization_id")
  organization     Organization           @relation(fields: [organizationId], references: [id])
  name             String
  partnerKind      PartnerKind            @map("partner_kind")
  partnerType      PartnerType            @map("partner_type")
  status           DirectoryProfileStatus @default(active)
  contactName      String?                @map("contact_name")
  contactRole      PartnerContactRole?    @map("contact_role")
  contactPhone     String?                @map("contact_phone")
  settlementMethod SettlementMethod?      @map("settlement_method")
  paymentTermRule  SettlementCycle?       @map("payment_term_rule")
  settlementNotes  String?                @map("settlement_notes")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  routeTemplateResources RouteTemplateResource[]
  segmentResources    SegmentResource[]
  sourceOrders        SourceOrder[]

  @@unique([organizationId, name])
  @@map("partners")
}

model RouteTemplate {
  id              String                 @id @default(cuid())
  organizationId  String                 @map("organization_id")
  organization    Organization           @relation(fields: [organizationId], references: [id])
  name            String
  defaultDayCount Int                    @map("default_day_count")
  usageCount      Int                    @default(0) @map("usage_count")
  notes           String?
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  segments        RouteTemplateSegment[]

  @@unique([organizationId, name])
  @@map("route_templates")
}

model RouteTemplateSegment {
  id          String                  @id @default(cuid())
  templateId  String                  @map("template_id")
  template    RouteTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sortOrder   Int                     @map("sort_order")
  name        String
  dayCount    Int                     @map("day_count")
  destination String?
  notes       String?
  resources   RouteTemplateResource[]

  @@map("route_template_segments")
}

model RouteTemplateResource {
  id                String               @id @default(cuid())
  templateSegmentId String               @map("template_segment_id")
  templateSegment   RouteTemplateSegment @relation(fields: [templateSegmentId], references: [id], onDelete: Cascade)
  resourceKind      ResourceKind         @map("resource_kind")
  counterpartyType  CounterpartyType     @map("counterparty_type")
  partnerId         String?              @map("partner_id")
  partner           Partner?             @relation(fields: [partnerId], references: [id])
  supplierId        String?              @map("supplier_id")
  supplier          Supplier?            @relation(fields: [supplierId], references: [id])
  title             String
  amountCents       Int                  @map("amount_cents")
  notes             String?

  @@map("route_template_resources")
}

model Departure {
  id               String               @id @default(cuid())
  organizationId   String               @map("organization_id")
  organization     Organization         @relation(fields: [organizationId], references: [id])
  departureNo      String               @map("departure_no")
  name             String
  routeName        String               @map("route_name")
  routeSource      DepartureRouteSource @default(manual) @map("route_source")
  sourceTemplateId String?              @map("source_template_id")
  departureType    DepartureType        @default(combined) @map("departure_type")
  startDate        DateTime             @map("start_date") @db.Date
  endDate          DateTime             @map("end_date") @db.Date
  dayCount         Int                  @map("day_count")
  ownerUserId      String               @map("owner_user_id")
  owner            User                 @relation("DepartureOwner", fields: [ownerUserId], references: [id])
  status           DepartureStatus      @default(editing)
  notes            String?
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  paymentSchedules PaymentSchedule[]
  financeTransactions FinanceTransaction[]
  itinerarySegments   ItinerarySegment[]
  sourceOrders        SourceOrder[]
  archiveHistories    DepartureArchiveHistory[]
  settlementHistories DepartureSettlementHistory[]

  @@unique([organizationId, departureNo])
  @@map("departures")
}

model DepartureArchiveHistory {
  id             String                 @id @default(cuid())
  organizationId String                 @map("organization_id")
  organization   Organization           @relation(fields: [organizationId], references: [id])
  departureId    String                 @map("departure_id")
  departure      Departure              @relation(fields: [departureId], references: [id], onDelete: Cascade)
  action         DepartureArchiveAction
  reason         String
  operatedBy     String                 @map("operated_by")
  operator       User                   @relation("DepartureArchiveOperator", fields: [operatedBy], references: [id])
  operatedAt     DateTime               @default(now()) @map("operated_at")

  @@index([departureId, operatedAt])
  @@index([organizationId, departureId])
  @@map("departure_archive_histories")
}

model DepartureSettlementHistory {
  id                       String          @id @default(cuid())
  organizationId           String          @map("organization_id")
  organization             Organization    @relation(fields: [organizationId], references: [id])
  departureId              String          @map("departure_id")
  departure                Departure       @relation(fields: [departureId], references: [id], onDelete: Cascade)
  triggerPaymentScheduleId String          @map("trigger_payment_schedule_id")
  triggerPaymentSchedule   PaymentSchedule @relation(fields: [triggerPaymentScheduleId], references: [id])
  reason                   String
  previousStatus           DepartureStatus @map("previous_status")
  newStatus                DepartureStatus @map("new_status")
  operatedBy               String          @map("operated_by")
  operator                 User            @relation("DepartureSettlementOperator", fields: [operatedBy], references: [id])
  operatedAt               DateTime        @default(now()) @map("operated_at")

  @@index([departureId, operatedAt])
  @@index([organizationId, departureId])
  @@map("departure_settlement_histories")
}

model SourceOrder {
  id                    String                    @id @default(cuid())
  departureId           String                    @map("departure_id")
  departure             Departure                 @relation(fields: [departureId], references: [id], onDelete: Cascade)
  partnerId             String                    @map("partner_id")
  partner               Partner                   @relation(fields: [partnerId], references: [id])
  displayName           String                    @map("display_name")
  guestCount            Int                       @map("guest_count")
  adultGuestCount       Int                       @map("adult_guest_count")
  childGuestCount       Int                       @map("child_guest_count")
  adultUnitPriceCents   Int                       @map("adult_unit_price_cents")
  childUnitPriceCents   Int                       @map("child_unit_price_cents")
  grossReceivableCents  Int                       @map("gross_receivable_cents")
  discountType          SourceOrderDiscountType   @default(none) @map("discount_type")
  discountCents         Int                       @default(0) @map("discount_cents")
  discountNotes         String?                   @map("discount_notes")
  netReceivableCents    Int                       @map("net_receivable_cents")
  collectionMode        SourceOrderCollectionMode @map("collection_mode")
  partnerCollectedCents Int                       @map("partner_collected_cents")
  guestCollectCents     Int                       @map("guest_collect_cents")
  settlementNotes       String?                   @map("settlement_notes")
  notes                 String?
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  guests                SourceOrderGuest[]

  @@index([departureId, partnerId])
  @@map("source_orders")
}

model SourceOrderGuest {
  id            String      @id @default(cuid())
  sourceOrderId String      @map("source_order_id")
  sourceOrder   SourceOrder @relation(fields: [sourceOrderId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  gender        GuestGender @default(unknown)
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("source_order_guests")
}

model ItinerarySegment {
  id                   String            @id @default(cuid())
  departureId          String            @map("departure_id")
  departure            Departure         @relation(fields: [departureId], references: [id], onDelete: Cascade)
  name                 String
  startDate            DateTime          @map("start_date") @db.Date
  endDate              DateTime          @map("end_date") @db.Date
  dayCount             Int               @map("day_count")
  destination  String?
  notes        String?
  resources            SegmentResource[]

  @@map("itinerary_segments")
}

model SegmentResource {
  id               String           @id @default(cuid())
  segmentId        String           @map("segment_id")
  segment          ItinerarySegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  resourceKind     ResourceKind     @map("resource_kind")
  counterpartyType CounterpartyType @map("counterparty_type")
  partnerId        String?          @map("partner_id")
  partner          Partner?         @relation(fields: [partnerId], references: [id])
  supplierId       String?          @map("supplier_id")
  supplier         Supplier?        @relation(fields: [supplierId], references: [id])
  title            String
  amountCents      Int              @map("amount_cents")
  notes            String?

  @@map("segment_resources")
}

model PaymentSchedule {
  id               String                   @id @default(cuid())
  organizationId   String                   @map("organization_id")
  organization     Organization             @relation(fields: [organizationId], references: [id])
  departureId      String                   @map("departure_id")
  departure        Departure                @relation(fields: [departureId], references: [id])
  direction        PaymentScheduleDirection
  scheduleNo       String                   @map("schedule_no")
  title            String
  amountCents      Int                      @map("amount_cents")
  dueDate          DateTime                 @map("due_date") @db.Date
  counterpartyType CounterpartyType         @map("counterparty_type")
  counterpartyId   String?                  @map("counterparty_id")
  counterpartyName String?                  @map("counterparty_name")
  sourceType       String                   @default("manual") @map("source_type")
  sourceId         String?                  @map("source_id")
  cancelledAt      DateTime?                @map("cancelled_at")
  cancelledBy      String?                  @map("cancelled_by")
  cancelOperator   User?                    @relation("PaymentScheduleCancelOperator", fields: [cancelledBy], references: [id])
  closeDisposition PaymentScheduleCloseDisposition? @map("close_disposition")
  cancelReason     String?                  @map("cancel_reason")
  amountAdjustedAt DateTime?                @map("amount_adjusted_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  verifications FinanceVerification[]
  activities    PaymentScheduleActivity[]
  settlementHistories DepartureSettlementHistory[]

  @@unique([organizationId, scheduleNo])
  @@index([organizationId, departureId])
  @@map("payment_schedules")
}

model PaymentScheduleActivity {
  id                           String                            @id @default(cuid())
  organizationId               String                            @map("organization_id")
  organization                 Organization                      @relation(fields: [organizationId], references: [id])
  paymentScheduleId            String                            @map("payment_schedule_id")
  paymentSchedule              PaymentSchedule                   @relation(fields: [paymentScheduleId], references: [id], onDelete: Cascade)
  activityType                 PaymentScheduleActivityType       @map("activity_type")
  closeDisposition             PaymentScheduleCloseDisposition?  @map("close_disposition")
  note                         String
  amountCents                  Int?                              @map("amount_cents")
  settledAmountCents           Int?                              @map("settled_amount_cents")
  unsettledAmountCents         Int?                              @map("unsettled_amount_cents")
  previousSettledAmountCents   Int?                              @map("previous_settled_amount_cents")
  previousUnsettledAmountCents Int?                              @map("previous_unsettled_amount_cents")
  verificationId               String?                           @map("verification_id")
  operatedBy                   String                            @map("operated_by")
  operator                     User                              @relation("PaymentScheduleActivityOperator", fields: [operatedBy], references: [id])
  operatedAt                   DateTime                          @default(now()) @map("operated_at")

  @@index([paymentScheduleId, operatedAt])
  @@index([organizationId, paymentScheduleId])
  @@map("payment_schedule_activities")
}

model FinanceTransaction {
  id               String               @id @default(cuid())
  organizationId   String               @map("organization_id")
  organization     Organization         @relation(fields: [organizationId], references: [id])
  transactionNo    String               @map("transaction_no")
  direction        TransactionDirection
  paymentChannel   PaymentChannel       @default(other) @map("payment_channel")
  amountCents      Int                  @map("amount_cents")
  transactionDate  DateTime             @map("transaction_date") @db.Date
  counterpartyType CounterpartyType     @map("counterparty_type")
  counterpartyId   String?              @map("counterparty_id")
  counterpartyName String?              @map("counterparty_name")
  departureId      String?              @map("departure_id")
  departure        Departure?           @relation(fields: [departureId], references: [id])
  voidedAt         DateTime?            @map("voided_at")
  voidReason       String?              @map("void_reason")
  notes            String?
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  verifications    FinanceVerification[]

  @@unique([organizationId, transactionNo])
  @@index([organizationId, departureId])
  @@map("finance_transactions")
}

model FinanceVerification {
  id                      String             @id @default(cuid())
  organizationId          String             @map("organization_id")
  organization            Organization       @relation(fields: [organizationId], references: [id])
  verificationNo          String             @map("verification_no")
  paymentScheduleId       String             @map("payment_schedule_id")
  paymentSchedule         PaymentSchedule    @relation(fields: [paymentScheduleId], references: [id])
  transactionId           String             @map("transaction_id")
  transaction             FinanceTransaction @relation(fields: [transactionId], references: [id])
  amountCents             Int                @map("amount_cents")
  verificationDate        DateTime           @map("verification_date") @db.Date
  remark                  String?
  createdBy               String             @map("created_by")
  cancelledBy             String?            @map("cancelled_by")
  cancelReason            String?            @map("cancel_reason")
  billUnsettledAfterCents Int                @map("bill_unsettled_after_cents")
  status                  VerificationStatus @default(normal)
  cancelledAt             DateTime?          @map("cancelled_at")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  @@unique([organizationId, verificationNo])
  @@index([paymentScheduleId, status])
  @@index([transactionId, status])
  @@map("finance_verifications")
}
