{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "pnpm --filter @xiaotuanbao/shared build && nest build && tsc -p tsconfig.seed.json",
    "dev": "pnpm --filter @xiaotuanbao/shared build && concurrently -k -n shared,api,reload -c blue,green,magenta \"pnpm --filter @xiaotuanbao/shared build:watch\" \"nest start --watch\" \"node scripts/watch-shared-reload.js\"",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.seed.json --noEmit",
    "lint": "pnpm typecheck",
    "test": "jest --config jest.config.js",
    "test:e2e": "dotenv -e ../../.env -- jest --config jest-e2e.config.js --runInBand",
    "test:e2e:ci": "dotenv -e ../../.env -- jest --config jest-e2e.config.js --runInBand --testPathIgnorePatterns=seed-demo-business-loop",
    "test:permission-matrix": "dotenv -e ../../.env -- jest --config jest-e2e.config.js --runInBand test/permission-matrix.e2e-spec.ts",
    "test:permission-matrix:update": "dotenv -e ../../.env -- jest --config jest-e2e.config.js --runInBand -u test/permission-matrix.e2e-spec.ts",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:reset-departures": "dotenv -e ../../.env -- tsx scripts/reset-demo-departures.ts",
    "db:cleanup-e2e-departures": "dotenv -e ../../.env -- tsx scripts/cleanup-e2e-departures.ts",
    "db:clear-business-data": "dotenv -e ../../.env -- tsx scripts/clear-business-data.ts",
    "finance:integrity-check": "dotenv -e ../../.env -- tsx scripts/finance-integrity-check.ts",
    "db:seed-demo-loop": "dotenv -e ../../.env -- jest --config jest-e2e.config.js --runInBand test/seed-demo-business-loop.e2e-spec.ts",
    "db:seed-workbench-display": "dotenv -e ../../.env -- tsx scripts/seed-workbench-display-boundary.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.3",
    "@prisma/client": "^6.9.0",
    "@xiaotuanbao/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "exceljs": "^4.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.30",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.1.2",
    "dotenv-cli": "^8.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.3.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "node dist/prisma/seed.js"
  }
}
