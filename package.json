{
  "name": "xiaotuanbao",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:agent": "pnpm --filter agent dev",
    "dev:workflow-worker": "pnpm --filter api dev:workflow-worker",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "preview:web": "pnpm --filter web preview",
    "eval:offline": "pnpm --filter @xiaotuanbao/ai-contracts eval:offline",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:web": "pnpm --filter web typecheck",
    "typecheck:api": "pnpm --filter api typecheck",
    "lint:web": "pnpm typecheck:web",
    "lint:api": "pnpm typecheck:api",
    "test:e2e:ci": "pnpm --filter api test:e2e:ci",
    "test:e2e:web": "pnpm --filter web-e2e test",
    "test:e2e:web:ui": "pnpm --filter web-e2e test:ui",
    "verify:ci": "pnpm typecheck && pnpm test:e2e:ci",
    "gen:permission-matrix": "pnpm --filter api test:permission-matrix:update",
    "check:permission-matrix": "bash scripts/check-permission-matrix.sh",
    "hooks:install": "git config core.hooksPath .githooks && echo 'git hooks 已启用（.githooks）'",
    "db:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d postgres",
    "db:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml stop postgres",
    "garage:up": "docker compose up -d garage",
    "garage:down": "docker compose stop garage",
    "ocr:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --profile ocr up -d --build ocr",
    "ocr:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --profile ocr stop ocr",
    "ocr:logs": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --profile ocr logs -f ocr",
    "ocr:smoke": "bash scripts/ocr-smoke.sh",
    "db:migrate": "pnpm --filter api prisma:migrate:dev",
    "db:seed": "pnpm --filter api prisma:db:seed",
    "finance:integrity-check": "pnpm --filter api finance:integrity-check",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart:api": "docker compose restart api",
    "docker:migrate": "docker compose exec api pnpm exec prisma migrate deploy",
    "docker:seed": "docker compose exec api pnpm exec prisma db seed",
    "prototype:route-ledger-mode": "pnpm --filter web dev",
    "prototype:execution-layer-switch": "pnpm --filter web dev"
  },
  "engines": {
    "node": ">=22.13"
  }
}
