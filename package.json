{
  "name": "xiaotuanbao",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "preview:web": "pnpm --filter web preview",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:web": "pnpm --filter web typecheck",
    "typecheck:api": "pnpm --filter api typecheck",
    "lint:web": "pnpm typecheck:web",
    "lint:api": "pnpm typecheck:api",
    "test:e2e:ci": "pnpm --filter api test:e2e:ci",
    "verify:ci": "pnpm typecheck && pnpm test:e2e:ci",
    "db:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d postgres",
    "db:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml stop postgres",
    "db:migrate": "pnpm --filter api prisma:migrate:dev",
    "db:seed": "pnpm --filter api prisma:db:seed",
    "finance:integrity-check": "pnpm --filter api finance:integrity-check",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart:api": "docker compose restart api",
    "docker:migrate": "docker compose exec api pnpm exec prisma migrate deploy",
    "docker:seed": "docker compose exec api pnpm exec prisma db seed"
  },
  "engines": {
    "node": ">=22.13"
  }
}
