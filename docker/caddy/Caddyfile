{$DOMAIN} {
    root * /srv/web

    @notAgentStream not path /api/agent/conversations/*/stream
    encode @notAgentStream gzip zstd

    handle /api/agent/conversations/*/stream {
        reverse_proxy api:3000 {
            flush_interval -1
            header_up Accept-Encoding identity
            header_down -Content-Encoding
            header_down Cache-Control "no-cache, no-transform"
            header_down X-Accel-Buffering "no"
        }
    }

    handle /api/* {
        reverse_proxy api:3000
    }

    handle /copilotkit* {
        reverse_proxy agent:4111
    }

    handle {
        try_files {path} /index.html
        file_server
    }
}
