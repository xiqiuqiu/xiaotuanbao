# App
APP_NAME=小团宝
NODE_ENV=development

# Caddy 站点地址（Docker 全栈部署，见 docs/deploy/environment-variables.md）
# 本地 Docker：:80
# 生产环境：your-domain.com
CADDY_DOMAIN=:80

# API
API_PORT=3000
JWT_SECRET=please-change-this-secret
JWT_EXPIRES_IN=7d

# Database
POSTGRES_USER=xiaotuanbao
POSTGRES_PASSWORD=please-change-this-password
POSTGRES_DB=xiaotuanbao

# 本地开发（pnpm dev:api + docker postgres 暴露 5432）
DATABASE_URL=postgresql://xiaotuanbao:please-change-this-password@localhost:5432/xiaotuanbao?schema=public

# Docker 全栈部署时可选调整（api 容器内 DATABASE_URL 由 docker-compose 自动注入 postgres 主机名）
# NODE_ENV=production
# CADDY_DOMAIN=your-domain.com
# UPLOAD_DIR=/app/uploads

# Upload
UPLOAD_DIR=./uploads

# Frontend
VITE_APP_NAME=小团宝
VITE_API_BASE_URL=/api
VITE_APP_ENV=development

# Seed（pnpm db:seed 或 pnpm docker:seed 使用）
SEED_ORG_NAME=演示旅行社
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=演示管理员
