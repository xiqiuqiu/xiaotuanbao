# App
APP_NAME=小团宝
NODE_ENV=development
DOMAIN=localhost

# API
API_PORT=3000
JWT_SECRET=please-change-this-secret
JWT_EXPIRES_IN=7d

# Database
POSTGRES_USER=xiaotuanbao
POSTGRES_PASSWORD=please-change-this-password
POSTGRES_DB=xiaotuanbao
# 本地开发（docker compose 暴露 5432）
DATABASE_URL=postgresql://xiaotuanbao:please-change-this-password@localhost:5432/xiaotuanbao?schema=public
# 容器内网络（生产 docker compose 全栈时使用）
# DATABASE_URL=postgresql://xiaotuanbao:please-change-this-password@postgres:5432/xiaotuanbao?schema=public

# Upload
UPLOAD_DIR=/app/uploads

# Frontend
VITE_APP_NAME=小团宝
VITE_API_BASE_URL=/api
VITE_APP_ENV=development
