# App
APP_NAME=小团宝
NODE_ENV=development

# Caddy 站点地址（Docker 全栈部署，见 docs/deploy/environment-variables.md）
# 本地 Docker：:80
# 生产环境：your-domain.com
CADDY_DOMAIN=:80

# API
API_PORT=3000
JWT_SECRET=please-change-this-secret
JWT_EXPIRES_IN=7d
# 浏览器允许访问 API 的精确 Origin，多个值用逗号分隔；生产必填
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 生产必须为 true；本地 pnpm 开发使用 false
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# 仅迁移旧 Web 客户端的临时窗口设为 true，到期必须关闭
AUTH_ALLOW_LEGACY_BEARER=false

# Database
POSTGRES_USER=xiaotuanbao
POSTGRES_PASSWORD=please-change-this-password
POSTGRES_DB=xiaotuanbao

# 本地开发（pnpm dev:api + docker postgres 暴露 5432）
# Windows 上 Prisma 对 localhost(IPv6) 可能 P1001，本地请用 127.0.0.1
DATABASE_URL=postgresql://xiaotuanbao:please-change-this-password@127.0.0.1:5432/xiaotuanbao?schema=public

# Docker 全栈部署时可选调整（api 容器内 DATABASE_URL 由 docker-compose 自动注入 postgres 主机名）
# NODE_ENV=production
# CADDY_DOMAIN=your-domain.com

# Object storage (S3-compatible; ADR-0027). Dev/Compose: Garage.
# Local pnpm + docker compose garage: endpoint is host-mapped 3900.
# Inside the api container use http://garage:3900 (compose overrides).
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=xiaotuanbao
# Must match Garage bootstrap env (GARAGE_DEFAULT_*). Sample keys for local/CI only.
S3_ACCESS_KEY=GKaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
S3_SECRET_KEY=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
# UPLOAD_DIR=./uploads  # legacy

# Local OCR service (pnpm ocr:up). Local pnpm API uses the host endpoint.
# A Compose API container should use http://ocr:8089 when the OCR profile is enabled.
OCR_BASE_URL=http://127.0.0.1:8089
OCR_REQUEST_TIMEOUT_MS=60000

# Frontend
VITE_APP_NAME=小团宝
VITE_API_BASE_URL=/api
VITE_APP_ENV=development

# AI 建团辅助（#297）。预览/本地可开；生产默认关。
AI_CREATE_ASSIST_ENABLED=false
# 可选：逗号分隔的 User id 白名单；空表示开关打开后对所有具备 departure:write 的 User 生效
# AI_CREATE_ASSIST_USER_IDS=
AGENT_SERVICE_SECRET=dev-agent-service-secret-change-me
AGENT_RUNTIME_URL=/copilotkit
# Worker 调用无头 Agent 的内部地址（浏览器仍走 AGENT_RUNTIME_URL / Caddy）
AGENT_INTERNAL_URL=http://127.0.0.1:4111
# 预览/本地单一模型（#297）。Agent 进程读取，不要提交真实密钥。
AI_MODEL=deepseek/deepseek-chat
AI_MODEL_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
COPILOTKIT_TELEMETRY_DISABLED=true

# Seed（pnpm db:seed 或 pnpm docker:seed 使用）
SEED_ORG_NAME=演示旅行社
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=演示管理员
