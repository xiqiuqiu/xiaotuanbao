# App
APP_NAME=小团宝
NODE_ENV=development

# Caddy 站点地址（Docker 全栈部署，见 docs/deploy/environment-variables.md）
# 本地 Docker：:80
# 生产环境：your-domain.com
CADDY_DOMAIN=:80

# API
API_PORT=3000
JWT_SECRET=please-change-this-secret
JWT_EXPIRES_IN=7d
# 浏览器允许访问 API 的精确 Origin，多个值用逗号分隔；生产必填
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 生产必须为 true；本地 pnpm 开发使用 false
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# 仅迁移旧 Web 客户端的临时窗口设为 true，到期必须关闭
AUTH_ALLOW_LEGACY_BEARER=false

# Database
POSTGRES_USER=xiaotuanbao
POSTGRES_PASSWORD=please-change-this-password
POSTGRES_DB=xiaotuanbao

# 本地开发（pnpm dev:api + docker postgres 暴露 5432）
DATABASE_URL=postgresql://xiaotuanbao:please-change-this-password@localhost:5432/xiaotuanbao?schema=public

# Docker 全栈部署时可选调整（api 容器内 DATABASE_URL 由 docker-compose 自动注入 postgres 主机名）
# NODE_ENV=production
# CADDY_DOMAIN=your-domain.com

# Object storage (S3-compatible; ADR-0027). Dev/Compose: Garage.
# Local pnpm + docker compose garage: endpoint is host-mapped 3900.
# Inside the api container use http://garage:3900 (compose overrides).
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=xiaotuanbao
# Must match Garage bootstrap env (GARAGE_DEFAULT_*). Sample keys for local/CI only.
S3_ACCESS_KEY=GKaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
S3_SECRET_KEY=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
# UPLOAD_DIR=./uploads  # legacy

# Frontend
VITE_APP_NAME=小团宝
VITE_API_BASE_URL=/api
VITE_APP_ENV=development

# Seed（pnpm db:seed 或 pnpm docker:seed 使用）
SEED_ORG_NAME=演示旅行社
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=演示管理员
